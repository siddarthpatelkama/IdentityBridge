# Server Configuration
PORT=5000

# Supabase Credentials
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# OpenAI API Credentials
OPENAI_API_KEY=your-openai-api-key

# Face Verification Credentials (Face++ or AWS)
# For Face++:
FACEPLUSPLUS_API_KEY=your-faceplusplus-api-key
FACEPLUSPLUS_API_SECRET=your-faceplusplus-api-secret

# For AWS Rekognition (optional alternate):
# AWS_ACCESS_KEY_ID=your-aws-access-key-id
# AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
# AWS_REGION=us-east-1

# Twilio Credentials (optional, for SMS notifications)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890
